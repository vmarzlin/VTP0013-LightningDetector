<Window x:Class="LightningDetector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lightning Detector" Height="760" Width="1000" Icon="AppIcon.ico">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Port COM:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="PortComboBox" Width="120"/>
            <TextBlock Text="Baudrate:" VerticalAlignment="Center" Margin="12,0,8,0"/>
            <ComboBox x:Name="BaudRateComboBox" Width="100">
                <ComboBoxItem Content="9600"/>
                <ComboBoxItem Content="115200" IsSelected="True"/>
            </ComboBox>
            <Button x:Name="ConnectToggleButton" Content="Connexion" Width="90" Margin="12,0,0,0" Click="ConnectToggleButton_Click"/>
            <Button x:Name="PauseResumeButton" Content="Pause" Width="90" Margin="8,0,0,0" Click="PauseResumeButton_Click"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border BorderBrush="LightGray" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="État du module" FontWeight="Bold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="Gray" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ModuleStatusText" Text="Non connecté"/>
                    </StackPanel>
                    <TextBlock x:Name="ModuleNameText" Text="AS3935" Margin="20,0,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" Padding="8" Margin="0,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Configuration du capteur" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Gain d'entrée optimisé pour" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <ComboBox x:Name="AfeComboBox" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="ConfigurationComboBox_SelectionChanged" IsEnabled="False">
                                <ComboBoxItem Content="intérieur"/>
                                <ComboBoxItem Content="extérieur"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="Seuil de bruit continu" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <ComboBox x:Name="NoiseThresholdComboBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="ConfigurationComboBox_SelectionChanged" IsEnabled="False">
                                <ComboBoxItem Content="0"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="Seuil de validation du signal" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <ComboBox x:Name="WatchdogThresholdComboBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="ConfigurationComboBox_SelectionChanged" IsEnabled="False">
                                <ComboBoxItem Content="0"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="9"/>
                                <ComboBoxItem Content="10"/>
                            </ComboBox>

                            <TextBlock Grid.Row="3" Text="Niveau de rejet des pics" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <ComboBox x:Name="SpikeRejectComboBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="ConfigurationComboBox_SelectionChanged" IsEnabled="False">
                                <ComboBoxItem Content="0"/>
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="9"/>
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="11"/>
                                <ComboBoxItem Content="12"/>
                                <ComboBoxItem Content="13"/>
                                <ComboBoxItem Content="14"/>
                                <ComboBoxItem Content="15"/>
                           </ComboBox>

                            <TextBlock Grid.Row="4" Text="Intercepter aussi les parasites" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <CheckBox x:Name="DisturberStateCheckBox" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,6" Checked="ConfigurationCheckBox_Checked" Unchecked="ConfigurationCheckBox_Checked" IsEnabled="False"/>

                            <TextBlock Grid.Row="5" Text="Nombre d'éclairs minimum" VerticalAlignment="Center" Margin="0,0,0,6"/>
                            <ComboBox x:Name="LightningThresholdComboBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="ConfigurationComboBox_SelectionChanged" IsEnabled="False">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="9"/>
                                <ComboBoxItem Content="16"/>
                            </ComboBox>

                            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="ReloadConfigurationButton" Content="Relire les paramètres" Click="ReloadConfigurationButton_Click" IsEnabled="False"/>
                                <Button x:Name="ResetConfigurationButton" Content="R.-A-Z." Margin="8,0,0,0" Click="ResetConfigurationButton_Click" IsEnabled="False"/>
                                <Border Width="1" Margin="8,2,0,2" Background="LightGray"/>
                                <Button x:Name="RecallConfigurationButton" Content="Rappeler" Margin="8,0,0,0" Click="RecallConfigurationButton_Click" IsEnabled="False"/>
                                <Button x:Name="SaveConfigurationButton" Content="Sauvegarder" Margin="8,0,0,0" Click="SaveConfigurationButton_Click" IsEnabled="False"/>
                                <ComboBox x:Name="ConfigurationSlotComboBox" Width="60" Margin="8,0,0,0" IsEnabled="False">
                                    <ComboBoxItem Content="0"/>
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="7"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Padding="8" Margin="4,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Mesures" FontWeight="Bold" Margin="0,0,0,8"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <!-- Icône à 2 états (orage en cours / pas d'orage) : basculer le Fill entre les 2 états -->
                            <Path x:Name="StormIcon" Data="M7,2V13H10V22L17,10H13L17,2H7Z" Fill="Gray" Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StormStatusText" Text="Aucun orage détecté" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="2" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="NoiseLevelTrack" Grid.Row="0" Width="24" Height="150" BorderBrush="Gray" BorderThickness="1" Background="WhiteSmoke" VerticalAlignment="Top">
                                    <Grid>
                                        <Grid VerticalAlignment="Bottom">
                                            <Rectangle x:Name="NoiseLevelFill" Width="22" Height="90" Fill="Red" VerticalAlignment="Bottom"/>
                                        </Grid>
                                        <TextBlock x:Name="NoiseUnavailableText" Text="N/A" FontSize="9" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="2" Text="Bruit" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </Grid>

                            <Grid Grid.Column="1" Margin="16,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="LightningChartBorder" Grid.Row="0" Height="150" Background="Black" BorderBrush="Gray" BorderThickness="1" VerticalAlignment="Top">
                                    <!-- Abscisse : 60 dernières minutes (gauche = passé, droite = maintenant). Ordonnée : distance de 0 (bas) à 40 km (haut). -->
                                    <Canvas x:Name="LightningChartCanvas" ClipToBounds="True">
                                        <Line X1="0" Y1="37.5" X2="{Binding ActualWidth, ElementName=LightningChartCanvas}" Y2="37.5" Stroke="#333333" StrokeThickness="1" StrokeDashArray="2,2"/>
                                        <Line X1="0" Y1="75" X2="{Binding ActualWidth, ElementName=LightningChartCanvas}" Y2="75" Stroke="#333333" StrokeThickness="1" StrokeDashArray="2,2"/>
                                        <Line X1="0" Y1="112.5" X2="{Binding ActualWidth, ElementName=LightningChartCanvas}" Y2="112.5" Stroke="#333333" StrokeThickness="1" StrokeDashArray="2,2"/>

                                        <TextBlock Text="40 km" Foreground="Gray" FontSize="9" Canvas.Left="4" Canvas.Top="2"/>
                                        <TextBlock Text="0 km" Foreground="Gray" FontSize="9" Canvas.Left="4" Canvas.Top="136"/>

                                        <!-- Éclairs : points ajoutés/repositionnés dynamiquement par RefreshLightningChart() -->
                                    </Canvas>
                                </Border>
                                <Grid Grid.Row="1" VerticalAlignment="Top" Margin="0,2,0,0">
                                    <TextBlock Text="-60 min" Foreground="Gray" FontSize="9" HorizontalAlignment="Left"/>
                                    <TextBlock Text="maintenant" Foreground="Gray" FontSize="9" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBlock x:Name="LightningLegendText" Grid.Row="2" Text="Aucun éclair" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </Grid>

                            <Grid Grid.Column="2" HorizontalAlignment="Center" Margin="4,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Width="20" Height="150" VerticalAlignment="Top">
                                    <Border BorderBrush="Gray" BorderThickness="1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                <GradientStop Color="DeepSkyBlue" Offset="0"/>
                                                <GradientStop Color="Gold" Offset="0.5"/>
                                                <GradientStop Color="Red" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Text="Max." Foreground="White" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <TextBlock Text="Min." Foreground="White" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                </Grid>
                                <TextBlock Grid.Row="2" Text="Énergie" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </Grid>

                            <Grid Grid.Column="3" HorizontalAlignment="Center" Margin="16,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="150"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="DisturberLevelTrack" Grid.Row="0" Width="24" Height="150" BorderBrush="Gray" BorderThickness="1" Background="WhiteSmoke" VerticalAlignment="Top">
                                    <Grid>
                                        <Grid VerticalAlignment="Bottom">
                                            <Rectangle x:Name="DisturberLevelFill" Width="22" Height="55" Fill="Orange" VerticalAlignment="Bottom"/>
                                        </Grid>
                                        <TextBlock x:Name="DisturberUnavailableText" Text="N/A" FontSize="9" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Row="2" Text="Parasites" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <TabControl Grid.Row="2">
                <TabItem Header="Vue synthétique">
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Éclairs détectés" FontWeight="Bold" Margin="0,0,0,6"/>
                            <DataGrid x:Name="DetectionsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date/heure" Binding="{Binding TimestampText}" Width="*"/>
                                    <DataGridTextColumn Header="Distance (km)" Binding="{Binding DistanceKmText}" Width="120"/>
                                    <DataGridTextColumn Header="Énergie" Binding="{Binding EnergyText}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="Données brutes">
                    <Border BorderBrush="LightGray" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.5*"/>
                                <ColumnDefinition Width="0.5*"/>
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="RawOutputTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Text="Commande manuelle" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="ManualCommandTextBox" KeyDown="ManualCommandTextBox_KeyDown" IsEnabled="False"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="ErrorQueryButton" Content="Erreur?" Width="80" Margin="0,0,8,0" Click="ManualQuickCommandButton_Click" IsEnabled="False" Tag=":SYSTem:ERRor?"/>
                                        <Button x:Name="ClearStatusButton" Content="CLS" Width="80" Margin="0,0,8,0" Click="ManualQuickCommandButton_Click" IsEnabled="False" Tag="*CLS"/>
                                        <Button x:Name="OperStatusButton" Content="OPER" Width="80" Margin="0,0,8,0" Click="ManualQuickCommandButton_Click" IsEnabled="False" Tag=":STATus:OPERation:COND?"/>
                                        <Button x:Name="QuesStatusButton" Content="QUES" Width="80" Click="ManualQuickCommandButton_Click" IsEnabled="False" Tag=":STATus:QUEStionable:COND?"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Intervalle Serial Polling" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="SerialPollingIntervalComboBox" Width="100" SelectionChanged="SerialPollingIntervalComboBox_SelectionChanged" IsEnabled="False">
                                        <ComboBoxItem Content="100ms"/>
                                        <ComboBoxItem Content="500ms"/>
                                        <ComboBoxItem Content="1s"/>
                                        <ComboBoxItem Content="2s"/>
                                        <ComboBoxItem Content="5s"/>
                                        <ComboBoxItem Content="10s"/>
                                    </ComboBox>
                                    <Button x:Name="ToggleSerialPollingButton" Content="Activer" Margin="8,0,0,0" Click="ToggleSerialPollingButton_Click" IsEnabled="False"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="État du registre STB" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <StackPanel Grid.Row="2" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse x:Name="StbBit0Led" Width="20" Height="20" Fill="LightGray" Margin="0,0,8,0"/>
                                        <TextBlock Text="bit 0 (réservé)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse x:Name="StbBit1Led" Width="20" Height="20" Fill="LightGray" Margin="0,0,8,0"/>
                                        <TextBlock Text="bit 1 (réservé)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse x:Name="StbBit2Led" Width="20" Height="20" Fill="LightGray" Margin="0,0,8,0"/>
                                        <TextBlock Text="bit 2 (EAV)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse x:Name="StbBit3Led" Width="20" Height="20" Fill="LightGray" Margin="0,0,8,0"/>
                                        <TextBlock Text="bit 3 (QUES)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse x:Name="StbBit4Led" Width="20" Height="20" Fill="LightGray" Margin="0,0,8,0"/>
                                        <TextBlock Text="bit 4 (MAV)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse x:Name="StbBit5Led" Width="20" Height="20" Fill="LightGray" Margin="0,0,8,0"/>
                                        <TextBlock Text="bit 5 (ESB)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse x:Name="StbBit6Led" Width="20" Height="20" Fill="LightGray" Margin="0,0,8,0"/>
                                        <TextBlock Text="bit 6 (RQS)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Ellipse x:Name="StbBit7Led" Width="20" Height="20" Fill="LightGray" Margin="0,0,8,0"/>
                                        <TextBlock Text="bit 7 (OPER)" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="ReadStbButton" Content="Lire STB" Width="120" IsEnabled="False" Click="ReadStbButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
